    "@nestjs/platform-fastify": "12.2.0",
    "@scripturetips/canon": "workspace:*",
    "@scripturetips/db": "workspace:*",
    "@scripturetips/licenses": "workspace:*",
    "@scripturetips/passage": "workspace:*",
    "@scripturetips/reference": "workspace:*",
    "@scripturetips/versification": "workspace:*",
    "altcha-lib": "2.6.0",
    "better-auth": "1.7.7",
    "ioredis": "5.11.1",
    "nodemailer": "10.1.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}
