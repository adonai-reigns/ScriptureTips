{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "dictionaryDefinitions": [
    { "name": "project-words", "path": "./cspell/project-words.txt", "addWords": true },
    { "name": "scripture-words", "path": "./cspell/scripture-words.txt" }
  ],
  "dictionaries": ["project-words", "scripture-words"],
  "ignorePaths": ["node_modules", "pnpm-lock.yaml", "docs/**", ".turbo", "coverage", "**/*.cjs"],
  "overrides": [
    {
      "filename": "**/locales/en-NZ/**",
      "language": "en-GB"
    }
  ]
}
