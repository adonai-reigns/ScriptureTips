{
  // Node can't run decorators from TypeScript source, so the API is compiled to dist/.
  // Workspace packages are still loaded from their TypeScript source.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    // With --incremental (the dev script), the watcher's first pass finds nothing changed and
    // writes nothing, so node --watch doesn't restart just after starting.
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "exclude": ["src/**/*.test.ts"]
}
