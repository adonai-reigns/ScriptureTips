{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./cspell/project-words.txt",
      "addWords": true
    },
    {
      "name": "scripture-words",
      "path": "./cspell/scripture-words.txt"
    }
  ],
  "dictionaries": ["project-words", "scripture-words"],
  "ignoreRegExpList": ["/[\\u0590-\\u05FF]+/g"],
  "ignorePaths": [
    "node_modules",
    "pnpm-lock.yaml",
    "docs/**",
    ".turbo",
    "coverage",
    "**/*.cjs",
    "tools/source-conversion/src/jps1917/corrections.ts",
    "packages/reference/src/languages/**",
    "**/dist/**",
    "**/.next/**",
    "**/test-results/**",
    "**/.work/**"
  ],
  "overrides": [
    {
      "filename": "**/locales/en-NZ/**",
      "language": "en-GB"
    },
    {
      "filename": "**/messages/en-NZ.json",
      "language": "en-GB"
    },
    {
      "filename": [
        "tools/pdf-trial/src/latex.ts",
        "tools/pdf-trial/templates/**",
        "packages/book/templates/**"
      ],
      "dictionaries": ["latex"],
      "ignoreRegExpList": ["/\\\\+[A-Za-z@]+/g"]
    }
  ]
}
