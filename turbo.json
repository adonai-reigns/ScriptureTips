{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "passThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL", "TEST_GARAGE_*", "TEST_STORAGE_*"]
    }
  }
}
